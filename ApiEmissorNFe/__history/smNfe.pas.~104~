  end;
{$METHODINFO OFF}

implementation


uses System.StrUtils, uEmiteNfe, JsonUtils;


function TNfeController.updateEmiteNFE(Value: TJSONObject): string;
var
    emiteNFE  : TEmiteNfe;
    res : string;
begin
   emiteNFE := TEmiteNfe.Create(Value.GetValue<string>('profile'));
   try
      res := emiteNFE.GerarNfe(dataReq.GetValue<TJSONObject>('nfe'));
      Result := res;
      JSONResponse(200,res);
   finally
      if Assigned(emiteNFE) then emiteNFE.Free;
   end;
end;

