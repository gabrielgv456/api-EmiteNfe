unit uAuthJWT;

interface
uses
  JOSE.Producer, System.SysUtils, JOSE.Core.JWA, JOSE.Core.JWT, JSON, JOSE.Core.Builder,IdContext, WebModuleUnit1;

type
   TAuthJWT = class
   public
      constructor Create;
      destructor Destroy;override;
      function createToken(key,cnpj:string):string;
      function isTokenValid(token:string):boolean;
      procedure DoParseAuthentication(AContext: TIdContext; const AAuthType, AAuthData: String; var VUsername, VPassword: String; var VHandled: Boolean);
   private
      const keyJWT = '6D490B099141E191E72EDA17CB682F1E93AE47408765C10A5014DA940CAD090823DF1CA3BA267F771851C842155C2798';
end;

implementation

uses
   JsonUtils, ServerConst1, smNfe;

constructor TAuthJWT.Create;

begin
   inherited Create;
end;

procedure TAuthJWT.DoParseAuthentication(AContext: TIdContext; const AAuthType, AAuthData: String; var VUsername, VPassword: String; var VHandled: Boolean);
var FJWT : TJWT;
begin
    GlobalConfig.isBearer := True;
    VHandled := AAuthType.Equals('Bearer') and IsTokenValid(AAuthData);
    GlobalConfig.isTokenValid := VHandled;
    if not VHandled then JSONResponse(401,'{"error":"Token Invalido"}');
end;

function TAuthJWT.isTokenValid(token:string):boolean;
var
   LToken   : TJWT;
   claims   : TJSONObject;
   user, key, profilePath : string;
begin
   token := token.Replace('Bearer ',emptyStr);
   try
      LToken := TJOSE.Verify(keyJWT,token);
      if Assigned(LToken) then
      begin
         try
            result := LToken.Verified;
            if LToken.Claims.Issuer <> 'Smart NF API - Solução fiscal para emissão de notas de forma ágil e moderna' then
               result:= False;
            if LToken.Claims.Expiration < Now then
               result:= False;
            if Result then begin
               claims := LToken.Claims.JSON;
               if (not containsProperty(claims,'user')) or (not containsProperty(claims,'key')) then begin
                  Result := False;
                  raise Exception.Create('nao contem user ou chave');
                  Exit;
               end;
               user := claims.GetValue<string>('user');
               key  := claims.GetValue<string>('key');
               if (user = EmptyStr) or (key = EmptyStr) then begin
                  raise Exception.Create('Error Message');
                  Result := False;
                  Exit;
               end;
               GlobalConfig.profile := key + '_' + user;
               GlobalConfig.cnpj := user;
               {$IFDEF LINUX}
                  profilePath := '/usr/local/modFiscalData' + '/profiles/' + GlobalConfig.profile + '/';
               {$ELSE}
                  profilePath := ExtractFilePath(ParamStr(0)) + '\profiles\' + GlobalConfig.profile + '\';
               {$ENDIF}

               if (not DirectoryExists(profilePath)) then begin
                  Result := False;
                  Exit;
               end;
            end;
         finally
            LToken.Free;
         end;
      end;
   except on E:Exception do
      Result := False;
   end
end;

function TAuthJWT.createToken(key,cnpj:string):string;
var
  LResult,profilePath: string;
begin
   {$IFDEF LINUX}
      profilePath := '/usr/local/modFiscalData' + '/profiles/' + key + '_' + cnpj + '/';
   {$ELSE}
      profilePath := ExtractFilePath(ParamStr(0)) + '\profiles\' + key + '_' + cnpj + '\';
   {$ENDIF}

   if (not DirectoryExists(profilePath)) or (key = '') or (cnpj = '') then
      raise Exception.Create('Chave e/ou CNPJ incorreto ou não configurado. Entre em contato conosco para obter sua identificação!' );

  LResult := TJOSEProcess.New
    .SetAlgorithm(TJOSEAlgorithmId.HS256)

    .SetIssuer('Smart NF API - Solução fiscal para emissão de notas de forma ágil e moderna')
    .SetIssuedAt(Now)
    .SetExpiration(Now + 1)
    .SetCustomClaim('user', cnpj)
    .SetCustomClaim('key', key)
    .SetKey(keyJWT)
    .Build
    .GetCompactToken
  ;
   var objResult := TJSONObject.Create;
   try
      objResult.AddPair('tokenJWT',LResult);
      Result := objResult.ToString;
   finally
      objResult.Free;
   end;
end;

destructor TAuthJWT.Destroy;
begin
   inherited;

end;

end.
