  ACBrNFe.NotasFiscais.GerarNFe;
  result := EnviaNfe;
end;


function TEmiteNFe.EnviaNFe() : string;
var pathSave, xml: string;
begin
    pathSave := profilePath + '\xmls\enviados\' + ACBrNFe.NotasFiscais.Items[0].NFe.infNFe.ID +'.xml';
    if not FileExists(pathSave) then begin

       ACBrNFe.NotasFiscais.Assinar;
       ACBrNFe.NotasFiscais.Validar;


       ACBrNFe.Enviar(1, False, True);

       ACbrNFe.NotasFiscais.GravarXML(pathSave);
       xml := loadFile(pathSave);

       if ACBrNFe.NotasFiscais.Items[0].NFe.procNFe.cStat <> 100 then begin
          raise Exception.Create( IntToStr(ACBrNFe.NotasFiscais.Items[0].NFe.procNFe.cStat) +
          ' - ' + ACBrNFe.NotasFiscais.Items[0].NFe.procNFe.xMsg);
       end;

       var objResult := TJSONObject.Create;
        try
           objResult.AddPair('NFe',ACBrNFe.NotasFiscais.Items[0].NFe.infNFe.ID);
           objResult.AddPair('tpAmb',TpAmbToStr(ACBrNFe.NotasFiscais.Items[0].NFe.procNFe.tpAmb));
           objResult.AddPair('verAplic',ACBrNFe.NotasFiscais.Items[0].NFe.procNFe.verAplic);
           objResult.AddPair('cStat',IntToStr(ACBrNFe.NotasFiscais.Items[0].NFe.procNFe.cStat));
           objResult.AddPair('xMotivo',ACBrNFe.NotasFiscais.Items[0].NFe.procNFe.xMotivo);
           objResult.AddPair('cMsg',IntToStr(ACBrNFe.NotasFiscais.Items[0].NFe.procNFe.cMsg));
           objResult.AddPair('xMsg',ACBrNFe.NotasFiscais.Items[0].NFe.procNFe.xMsg);
           objResult.AddPair('Protocolo',ACBrNFe.NotasFiscais.Items[0].NFe.procNFe.nProt);
           objResult.AddPair('profile',globalConfig.profile);
           objResult.AddPair('xml',xml);
           Result := objResult.ToString;
        finally
           objResult.Free;
        end;
    end else begin
        xml := loadFile(pathSave);
        var objResult := TJSONObject.Create;
        try
           objResult.AddPair('NFe',ACBrNFe.NotasFiscais.Items[0].NFe.infNFe.ID);
           objResult.AddPair('profile',globalConfig.profile);
           objResult.AddPair('xml',xml);
           Result := objResult.ToString;
        finally
           objResult.Free;
        end;
    end;
end;



function TEmiteNfe.AlimentareEnviarNF(req: TJSONObject; modelo: integer): string;
var
   reqNF : TNotaFiscalDTO;
   NotaF: NotaFiscal;
   Produto: TDetCollectionItem;
   InfoPgto: TpagCollectionItem;
   ObsComplementar : TobsContCollectionItem;
   ObsFisco: TobsFiscoCollectionItem;
   ok: Boolean;
begin
   reqNF := Rest.JSON.TJson.JsonToObject<TNotaFiscalDTO>(req);

   // CONFIGURACOES
   ACBrNFe.Configuracoes.Certificados.Senha  := AnsiString(reqNF.certificadoSenha);
   ACBRNfe.Configuracoes.Geral.CSC           := reqNF.codCSC ; // Token para emissao do QRCODE nfce, usuario precisa passar
   ACBRNfe.Configuracoes.WebServices.UF      := reqNF.cUF;

   // DADOS GERAIS
   NotaF := ACBrNFe.NotasFiscais.Add;
   NotaF.NFe.Ide.natOp     := reqNF.natOp;
   NotaF.NFe.Ide.modelo    := modelo; // Ajustar
   NotaF.NFe.Ide.serie     := reqNF.serie;
   NotaF.NFe.Ide.nNF       := reqNF.nNF;
   NotaF.NFe.Ide.cNF       := GerarCodigoDFe(NotaF.NFe.Ide.nNF);
   NotaF.NFe.Ide.dEmi      := Date;
   NotaF.NFe.Ide.dSaiEnt   := Date;
   NotaF.NFe.Ide.hSaiEnt   := Now;
   NotaF.NFe.Ide.cUF       := UFtoCUF(reqNF.cUF);
   NotaF.NFe.Ide.cMunFG    := reqNF.cMunFG;
   NotaF.NFe.Ide.verProc   := '1.0.0.0'; //Versão do seu sistema
   NotaF.NFe.Ide.indPag    := StrToIndpag(ok, reqNF.indPag);
   if not ok then raise Exception.Create('indPag incorreto!');
   NotaF.NFe.Ide.tpNF      := StrToTpNF(ok, IntToStr(reqNF.TpNF));
   if not ok then raise Exception.Create('tpNF incorreto');
   NotaF.NFe.Ide.tpEmis    := StrToTpEmis(ok, reqNF.tpEmis);
   if not ok then raise Exception.Create('tpEmis incorreto');
   NotaF.NFe.Ide.tpAmb     := StrToTpAmb(ok, reqNF.ambiente);
   if not ok then raise Exception.Create('ambiente incorreto');
   NotaF.NFe.Ide.indFinal  := StrToConsumidorFinal(ok,reqNF.indFinal);
   if not ok then raise Exception.Create('indFinal incorreto');
   NotaF.NFe.Ide.finNFe    := StrToFinNFe(ok,reqNF.finalidadeNFe);
   if not ok then raise Exception.Create('finalidadeNFe incorreto');
   if NotaF.NFe.Ide.modelo = 65 then begin
      NotaF.NFe.Ide.tpImp := tiNFCe;
      NotaF.NFe.Ide.indPres := StrToPresencaComprador(ok,reqNF.indPresenca);
      if not ok then raise Exception.Create('indPresenca incorreto !');
   end else begin
      if Assigned( ACBrNFe.DANFE ) then NotaF.NFe.Ide.tpImp := ACBrNFe.DANFE.TipoDANFE;
   end;

   // EMITENTE
   NotaF.NFe.Emit.CNPJCPF           := reqNF.Emitente.CNPJCPF;
   if NotaF.NFe.Emit.CNPJCPF        <> GlobalConfig.cnpj then raise Exception.Create('Emitente não confere com o autorizado!');
   NotaF.NFe.Emit.IE                := reqNF.Emitente.IE;
   NotaF.NFe.Emit.xNome             := reqNF.Emitente.razaoSocial;
   NotaF.NFe.Emit.xFant             := reqNF.Emitente.nomeFantasia;
   NotaF.NFe.Emit.CRT  := StrToCRT(Ok, IntToStr(reqNF.Emitente.CRT));
   if not ok then raise Exception.Create('CRT emitente incorreto');
   //NotaF.NFe.Emit.CNAE          := '6201500';

   // EMITENTE - ENDEREÇO
   NotaF.NFe.Emit.EnderEmit.fone    := reqNF.Emitente.Endereco.fone;
   NotaF.NFe.Emit.EnderEmit.CEP     := reqNF.Emitente.Endereco.CEP;
   NotaF.NFe.Emit.EnderEmit.xLgr    := reqNF.Emitente.Endereco.logradouro;
   NotaF.NFe.Emit.EnderEmit.nro     := reqNF.Emitente.Endereco.numero;
   NotaF.NFe.Emit.EnderEmit.xCpl    := reqNF.Emitente.Endereco.complemento;
   NotaF.NFe.Emit.EnderEmit.xBairro := reqNF.Emitente.Endereco.bairro;
   NotaF.NFe.Emit.EnderEmit.cMun    := reqNF.Emitente.Endereco.codMunicipio;
   NotaF.NFe.Emit.EnderEmit.xMun    := reqNF.Emitente.Endereco.nomeMunicipio;
   NotaF.NFe.Emit.EnderEmit.UF      := reqNF.Emitente.Endereco.UF;
   NotaF.NFe.Emit.enderEmit.cPais   := 1058;
   NotaF.NFe.Emit.enderEmit.xPais   := 'BRASIL';

   // DESTINATARIO
   if Assigned(reqNF.Destinatario) then begin

      NotaF.NFe.Dest.CNPJCPF           := reqNF.Destinatario.CNPJCPF;
      NotaF.NFe.Dest.indIEDest         := StrToindIEDest(ok,IntToStr(reqNF.Destinatario.indIEDest));
      if not ok then raise Exception.Create('indIEDest incorreto.');
      if NotaF.NFe.Dest.indIEDest = inContribuinte then
      NotaF.NFe.Dest.IE                := reqNF.Destinatario.IE;
      NotaF.NFe.Dest.ISUF              := reqNF.Destinatario.ISUF;
      NotaF.NFe.Dest.xNome             := reqNF.Destinatario.nome;

      // DESTINATARIO - ENDEREÇO
      NotaF.NFe.Dest.EnderDest.Fone    := reqNF.Destinatario.Endereco.fone;
      NotaF.NFe.Dest.EnderDest.CEP     := reqNF.Destinatario.Endereco.CEP;
      NotaF.NFe.Dest.EnderDest.xLgr    := reqNF.Destinatario.Endereco.logradouro;
      NotaF.NFe.Dest.EnderDest.nro     := reqNF.Destinatario.Endereco.numero;
      NotaF.NFe.Dest.EnderDest.xCpl    := reqNF.Destinatario.Endereco.complemento;
      NotaF.NFe.Dest.EnderDest.xBairro := reqNF.Destinatario.Endereco.bairro;
      NotaF.NFe.Dest.EnderDest.cMun    := reqNF.Destinatario.Endereco.codMunicipio;
      NotaF.NFe.Dest.EnderDest.xMun    := reqNF.Destinatario.Endereco.nomeMunicipio;
      NotaF.NFe.Dest.EnderDest.UF      := reqNF.Destinatario.Endereco.UF;
      NotaF.NFe.Dest.EnderDest.cPais   := 1058;
      NotaF.NFe.Dest.EnderDest.xPais   := 'BRASIL';

      if NotaF.NFe.Emit.EnderEmit.UF <> NotaF.NFe.Dest.EnderDest.UF then
      NotaF.NFe.Ide.idDest := TpcnDestinoOperacao.doInterestadual

   end else begin
      if (NotaF.NFe.Ide.modelo = 55) then raise Exception.Create('Para nota fiscal modelo 55 é obrigatório informar o cliente!');
   end;

   // ENTREGA
   if Assigned(reqNF.Entrega) then begin
      case AnsiIndexStr(UpperCase(reqNF.Entrega.Tipo),['RETIRADA','ENTREGA']) of

         0: begin //Use os campos abaixo para informar o endereço de retirada quando for diferente do Remetente/Destinatário
            NotaF.NFe.Retirada.CNPJCPF := reqNF.Entrega.CNPJCPF;
            NotaF.NFe.Retirada.xLgr    := reqNF.Entrega.logradouro;
            NotaF.NFe.Retirada.nro     := reqNF.Entrega.numero;
            NotaF.NFe.Retirada.xCpl    := reqNF.Entrega.complemento;
            NotaF.NFe.Retirada.xBairro := reqNF.Entrega.bairro;
            NotaF.NFe.Retirada.Cep     := reqNF.Entrega.CEP;
            NotaF.NFe.Retirada.cMun    := reqNF.Entrega.codMunicipio;
            NotaF.NFe.Retirada.xMun    := reqNF.Entrega.nomeMunicipio;
            NotaF.NFe.Retirada.UF      := reqNF.Entrega.UF;
         end;

         1 : begin //Use os campos abaixo para informar o endereço de entrega quando for diferente do Remetente/Destinatário
            NotaF.NFe.Entrega.CNPJCPF := reqNF.Entrega.CNPJCPF;
            NotaF.NFe.Entrega.xLgr    := reqNF.Entrega.logradouro;
            NotaF.NFe.Entrega.nro     := reqNF.Entrega.numero;
            NotaF.NFe.Entrega.xCpl    := reqNF.Entrega.complemento;
            NotaF.NFe.Entrega.xBairro := reqNF.Entrega.bairro;
            NotaF.NFe.Entrega.Cep     := reqNF.Entrega.CEP;
            NotaF.NFe.Entrega.cMun    := reqNF.Entrega.codMunicipio;
            NotaF.NFe.Entrega.xMun    := reqNF.Entrega.nomeMunicipio;
            NotaF.NFe.Entrega.UF      := reqNF.Entrega.UF;
         end;
      end;
   end;

   // PRODUTOS
   var counterProd := 0;
   for var reqProduto in reqNF.Produtos do begin

      Produto := NotaF.NFe.Det.New;
      Inc(counterProd);
      Produto.Prod.nItem      := counterProd ;
      Produto.Prod.cProd      := reqProduto.codigo;
      Produto.Prod.cEAN       := reqProduto.EAN;
      Produto.Prod.xProd      := reqProduto.descricao;
      Produto.Prod.NCM        := reqProduto.NCM;
      Produto.Prod.EXTIPI     := reqProduto.extIPI;
      Produto.Prod.CFOP       := reqProduto.CFOP;
      Produto.Prod.uCom       := reqProduto.unidade;
      Produto.Prod.qCom       := reqProduto.quantidade;
      Produto.Prod.CEST       := reqProduto.CEST;
      Produto.infAdProd       := reqProduto.infAdProd;
      Produto.Prod.cBarra     := reqProduto.codBarra;
      Produto.Prod.cBarraTrib := reqProduto.codBarraTrib;
      Produto.Prod.vUnCom     := reqProduto.valorUnitarioComerc;
      Produto.Prod.vProd      := reqProduto.valorTotalProdutos;

      Produto.Prod.cEANTrib  := reqProduto.EANTrib;
      Produto.Prod.uTrib     := reqProduto.unidadeTrib;
      Produto.Prod.qTrib     := reqProduto.quantidadeTrib;
      Produto.Prod.vUnTrib   := reqProduto.valorUnitarioTrib;

      Produto.Prod.vOutro    := reqProduto.valorOutro;
      Produto.Prod.vFrete    := reqProduto.valorFrete;
      Produto.Prod.vSeg      := reqProduto.valorSeguro;
      Produto.Prod.vDesc     := reqProduto.valorDesconto;

      // IMPOSTO DO PRODUTO
      with Produto.Imposto do
      begin

         vTotTrib := reqProduto.imposto.vTotTrib;

         // ICMS - IMPOSTO SOBRE CIRCULAÇÃO DE MERCADORIAS E SERVIÇOS
         if Assigned(reqProduto.imposto.ICMS) then begin
            with ICMS do begin
               // ORIGEM MERCADORIA
               orig := StrToOrig(ok,reqProduto.imposto.origemMercadoria) ;
               if not ok then raise Exception.Create('origemMercadoria incorreto!');

               // FCP - FUNDO DE COMBATE A POBREZA
               pFCP := reqProduto.imposto.ICMS.pFCP;
               vFCP := reqProduto.imposto.ICMS.vFCP;

               // DADOS ICMS NORMAL
               if NotaF.NFe.Emit.CRT in [crtSimplesExcessoReceita, crtRegimeNormal] then begin
                  CST  := StrToCSTICMS(ok, reqProduto.imposto.ICMS.CST);
                  if not ok then raise Exception.Create('CST incorreto!');
               end else begin
                  CSOSN := StrToCSOSNIcms(ok, reqProduto.imposto.ICMS.CSOSN);
                  if not ok then raise Exception.Create('CSOSN incorreto');
                  pCredSN := reqProduto.imposto.ICMS.pCredSN;
                  //vCredICMSSN := 100 * pCredSN / 100;
               end;
               if reqProduto.imposto.ICMS.modBC <> '' then begin
                  modBC := StrTomodBC(ok, reqProduto.imposto.ICMS.modBC);
                  if not ok then raise Exception.Create('modBC incorreto!');
               end;
               pRedBC     := reqProduto.imposto.ICMS.pRedBC;
               vBC        := reqProduto.imposto.ICMS.vBC;
               pICMS      := reqProduto.imposto.ICMS.pICMS;
               vICMS      := reqProduto.imposto.ICMS.vICMS;
               if  reqProduto.imposto.ICMS.motDesICMS <> emptyStr then begin
                  motDesICMS := StrTomotDesICMS(ok, reqProduto.imposto.ICMS.motDesICMS);
                  if not ok then raise Exception.Create('Motivo desoneração ICMS incorreto');
               end;

               // DADOS ICMS ST
               if reqProduto.imposto.ICMS.modBCST <> emptyStr then  begin
                  modBCST  := StrTomodBCST(ok, reqProduto.imposto.ICMS.modBCST);
                  if not ok then raise Exception.Create('modBCST incorreto!');
               end;
               pMVAST   := reqProduto.imposto.ICMS.pMVAST;
               pRedBCST := reqProduto.imposto.ICMS.pRedBCST;
               vBCST    := reqProduto.imposto.ICMS.vBCST;
               pICMSST  := reqProduto.imposto.ICMS.pICMSST;
               vICMSST  := reqProduto.imposto.ICMS.vICMSST;

            end;
         end;

         if Assigned(reqProduto.imposto.ICMSUFDest) then begin
            with ICMSUFDest do begin
               vBCUFDest      := reqProduto.imposto.ICMSUFDest.vBCUFDest;
               pFCPUFDest     := reqProduto.imposto.ICMSUFDest.pFCPUFDest;
               pICMSUFDest    := reqProduto.imposto.ICMSUFDest.pICMSUFDest;
               pICMSInter     := reqProduto.imposto.ICMSUFDest.pICMSInter;
               pICMSInterPart := reqProduto.imposto.ICMSUFDest.pICMSInterPart;
               vFCPUFDest     := reqProduto.imposto.ICMSUFDest.vFCPUFDest;
               vICMSUFDest    := reqProduto.imposto.ICMSUFDest.vICMSUFDest;
               vICMSUFRemet   := reqProduto.imposto.ICMSUFDest.vICMSUFRemet;
            end;
         end;

         // IPI - IMPOSTO SOBRE PRODUTO INDUSTRIALIZADO
         if Assigned(reqProduto.imposto.IPI) then begin
            with IPI do begin
               CST      := StrToCSTIPI(ok, reqProduto.imposto.IPI.CST);
               if not ok then raise Exception.Create('CST IPI incorreto!');
               pIPI     := reqProduto.imposto.IPI.pIPI;
               vIPI     := reqProduto.imposto.IPI.vIPI;
               clEnq    := reqProduto.imposto.IPI.clEnq;
               cSelo    := reqProduto.imposto.IPI.cSelo;
               qSelo    := reqProduto.imposto.IPI.qSelo;
               cEnq     := reqProduto.imposto.IPI.cEnq;
               CNPJProd := reqProduto.imposto.IPI.CNPJProd;
               vBC      := reqProduto.imposto.IPI.vBC;
            end;
         end;

         // PIS - PROGRAMA DE INTEGRAÇÃO SOCIAL
         if Assigned(reqProduto.imposto.PIS) then begin
            with PIS do
            begin
               CST  := StrToCSTPIS(ok,reqProduto.imposto.PIS.CST);
               if not ok then raise Exception.Create('CST PIS incorreto!');
               vBC  := reqProduto.imposto.PIS.vBC;
               pPIS := reqProduto.imposto.PIS.pPIS;
               vPIS := reqProduto.imposto.PIS.vPIS;
            end;
         end;

         // COFINS - CONTRIBUIÇÃO PARA O FINANCIAMENTO DA SEGURIDADE SOCIAL
         if Assigned(reqProduto.imposto.COFINS) then begin
            with COFINS do
            begin
               CST     := StrToCSTCOFINS(ok, reqProduto.imposto.COFINS.CST);
               if not ok then raise Exception.Create('CST COFINS incorreto!');
               vBC     := reqProduto.imposto.COFINS.vBC;
               pCOFINS := reqProduto.imposto.COFINS.pCOFINS;
               vCOFINS := reqProduto.imposto.COFINS.vCOFINS;
            end;
         end;
      end;
   end;

   if NotaF.NFe.Ide.modelo = 65 then
   NotaF.NFe.Transp.modFrete := mfSemFrete; // NFC-e não pode ter FRETE

   // PAGAMENTO
   for var reqPagamento in reqNF.Pagamento do begin
      InfoPgto := NotaF.NFe.pag.New;
      InfoPgto.indPag := StrToIndpag(ok,reqPagamento.condicao);
      if not ok then raise Exception.Create('condicao pagamento incorreto!');
      InfoPgto.tPag   := StrToFormaPagamento(Ok,reqPagamento.forma);
      if not ok then raise Exception.Create('forma pagamento incorreto!');
      InfoPgto.vPag   := reqPagamento.valor;
      InfoPgto.tpIntegra := TtpIntegra.tiPagNaoIntegrado;
   end;

   // TOTALIZAÇÃO
   NotaF.NFe.Total.ICMSTot.vBC          := reqNF.Total.ICMS.vBC;
   NotaF.NFe.Total.ICMSTot.vICMS        := reqNF.Total.ICMS.vICMS;
   NotaF.NFe.Total.ICMSTot.vBCST        := reqNF.Total.ICMS.vBCST;
   NotaF.NFe.Total.ICMSTot.vST          := reqNF.Total.ICMS.vST;
   NotaF.NFe.Total.ICMSTot.vProd        := reqNF.Total.ICMS.vProd;
   NotaF.NFe.Total.ICMSTot.vFrete       := reqNF.Total.ICMS.vFrete;
   NotaF.NFe.Total.ICMSTot.vSeg         := reqNF.Total.ICMS.vSeg;
   NotaF.NFe.Total.ICMSTot.vDesc        := reqNF.Total.ICMS.vDesc;
   NotaF.NFe.Total.ICMSTot.vII          := reqNF.Total.ICMS.vII;
   NotaF.NFe.Total.ICMSTot.vIPI         := reqNF.Total.ICMS.vIPI;
   NotaF.NFe.Total.ICMSTot.vPIS         := reqNF.Total.ICMS.vPIS;
   NotaF.NFe.Total.ICMSTot.vCOFINS      := reqNF.Total.ICMS.vCOFINS;
   NotaF.NFe.Total.ICMSTot.vOutro       := reqNF.Total.ICMS.vOutro;
   NotaF.NFe.Total.ICMSTot.vNF          := reqNF.Total.ICMS.vNF;
   NotaF.NFe.Total.ICMSTot.vFCPUFDest   := reqNF.Total.ICMS.vFCPUFDest;
   NotaF.NFe.Total.ICMSTot.vICMSUFDest  := reqNF.Total.ICMS.vICMSUFDest;
   NotaF.NFe.Total.ICMSTot.vICMSUFRemet := reqNF.Total.ICMS.vICMSUFRemet;
   NotaF.NFe.Total.ICMSTot.vFCPST       := reqNF.Total.ICMS.vFCPST;
   NotaF.NFe.Total.ICMSTot.vFCPSTRet    := reqNF.Total.ICMS.vFCPSTRet;
   NotaF.NFe.Total.ICMSTot.vTotTrib     := reqNF.Total.ICMS.vTotTrib;

   // Informações Adicionais
   NotaF.NFe.InfAdic.infCpl     :=  reqNF.InfAdicional.infComplementar;
   NotaF.NFe.InfAdic.infAdFisco :=  reqNF.InfAdicional.infAdicionalFisco;

   // Observações Complementares
   for var reqObsComplementar in reqNF.obsComplementar do begin
      ObsComplementar := NotaF.NFe.InfAdic.obsCont.New;
      ObsComplementar.xCampo := reqObsComplementar.campo;
      ObsComplementar.xTexto := reqObsComplementar.texto;
   end;

   // Observações Fisco
   for var reqObsFisco in reqNF.obsFisco do begin
      ObsFisco := NotaF.NFe.InfAdic.obsFisco.New;
      ObsFisco.xCampo := reqObsFisco.campo;
      ObsFisco.xTexto := reqObsFisco.texto;
   end;

   ACBrNFe.NotasFiscais.GerarNFe;
   result := EnviaNfe;

end;

destructor TEmiteNfe.Destroy;
begin
   inherited;
   GlobalConfig.profile := EmptyStr;
   if Assigned(ACBrNFe) then ACBrNFe.Free;
   if Assigned(ACBrMail) then ACBrMail.Free;
end;

end.
